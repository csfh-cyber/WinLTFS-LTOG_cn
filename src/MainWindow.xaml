<Window
    x:Class="LTOG.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LTOG"
    Title="LTOG">

    <Grid x:Name="Root" Language="zh-CN">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- icon + name, then page switchers; About/Settings sit left of the caption buttons.
             Two SelectorBars act as one group: selecting in one clears the other (Page_SelectionChanged) -->
        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
        <TitleBar x:Name="AppTitleBar">
            <TitleBar.Resources>
                <!-- template reserves a 48px drag gap before the caption buttons; the empty middle already drags -->
                <x:Double x:Key="TitleBarMinDragRegionWidth">0</x:Double>
                <!-- switchers follow the name instead of centring -->
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Left</HorizontalAlignment>
                <!-- don't fade the bar when the window is inactive (caption buttons: SyncCaptionColors) -->
                <x:Double x:Key="TitleBarDeactivatedOpacity">1</x:Double>
                <!-- tighter icon-to-name gap (default 16) -->
                <Thickness x:Key="TitleBarIconMargin">0,0,10,0</Thickness>
                <!-- switchers: subtle background for the selected page instead of the underline pill -->
                <SolidColorBrush x:Key="SelectorBarItemPillFill" Color="Transparent" />
                <StaticResource x:Key="SelectorBarItemBackgroundSelected" ResourceKey="SubtleFillColorSecondaryBrush" />
                <StaticResource x:Key="SelectorBarItemBackgroundPointerOver" ResourceKey="SubtleFillColorTertiaryBrush" />
                <StaticResource x:Key="SelectorBarItemBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                <StaticResource x:Key="SelectorBarItemForegroundPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
            </TitleBar.Resources>
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/icon.png" />
            </TitleBar.IconSource>
            <StackPanel Orientation="Horizontal" Spacing="16">
            <!-- own title text: TitleBar.Title is fixed to the small caption style -->
            <TextBlock Text="LTOG" VerticalAlignment="Center" FontFamily="ms-appx:///Assets/Oxanium.ttf#Oxanium"
                       FontWeight="ExtraBold" FontSize="20" CharacterSpacing="50"
                       TextLineBounds="Tight" />
            <SelectorBar x:Name="MainPages" HorizontalAlignment="Left" SelectionChanged="Page_SelectionChanged">
                <SelectorBarItem Tag="drives" Text="磁带机">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xEDA2;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem Tag="search" Text="搜索">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE721;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem Tag="tapes" Text="磁带">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem Tag="log" Text="日志">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE7C3;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
            </SelectorBar>
            </StackPanel>
            <TitleBar.RightHeader>
                <SelectorBar x:Name="TitleButtons" SelectionChanged="Page_SelectionChanged">
                    <SelectorBarItem Tag="kofi" ToolTipService.ToolTip="在 Ko-fi 上支持 LTOG" AutomationProperties.Name="在 Ko-fi 上支持项目">
                        <SelectorBarItem.Icon>
                            <FontIcon Glyph="&#xEB51;" />
                        </SelectorBarItem.Icon>
                    </SelectorBarItem>
                    <SelectorBarItem Tag="about" ToolTipService.ToolTip="关于" AutomationProperties.Name="关于">
                        <SelectorBarItem.Icon>
                            <FontIcon Glyph="&#xE946;" />
                        </SelectorBarItem.Icon>
                    </SelectorBarItem>
                    <SelectorBarItem Tag="settings" ToolTipService.ToolTip="设置" AutomationProperties.Name="设置">
                        <SelectorBarItem.Icon>
                            <FontIcon Glyph="&#xE713;" />
                        </SelectorBarItem.Icon>
                    </SelectorBarItem>
                </SelectorBar>
            </TitleBar.RightHeader>
        </TitleBar>
        </Border>

        <StackPanel Grid.Row="1">
            <InfoBar x:Name="EnvBar" Margin="12,8,12,0" IsOpen="False"
                     Severity="Error" IsClosable="False" Visibility="Collapsed" />
            <InfoBar Margin="12,0" IsOpen="True" Severity="Warning"
                     Title="磁带文件操作提醒"
                     Message="向磁带盘写入文件时，请使用复制，避免移动或剪切。正常卸载并核验数据后，再决定是否删除源文件。" />
            <InfoBar x:Name="TapeCloseNotice" Margin="12,0" Severity="Warning"
                     Title="请先卸载磁带"
                     Message="请在「磁带机」页面等待挂载或卸载操作完成，并卸载所有已挂载的磁带。全部卸载后，再关闭 LTOG。" />
        </StackPanel>

        <!-- tab strip only (pages live in PagesHost): one tab per drive, shown on Tape Drives with 2+ drives -->
        <Border x:Name="TabStrip" Grid.Row="2" Visibility="Collapsed"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <!-- SizeToContent: full labels; TabView adds left/right scroll buttons on overflow -->
            <TabView x:Name="Tabs" TabWidthMode="SizeToContent"
                     IsAddTabButtonVisible="False" CanReorderTabs="False" CanDragTabs="False"
                     SelectionChanged="Tabs_SelectionChanged">
                <TabView.Resources>
                    <Style TargetType="TabViewItem">
                        <Setter Property="MinWidth" Value="180" />
                    </Style>
                </TabView.Resources>
            </TabView>
        </Border>

        <!-- pages: one DrivePage per drive tab is added in code; the rest are fixed -->
        <Grid x:Name="PagesHost" Grid.Row="3">
            <local:NoDrivesPage x:Name="NoDrivesView" Visibility="Collapsed" />
            <local:SearchPage x:Name="SearchView" Visibility="Collapsed" />
            <local:TapesPage x:Name="TapesView" Visibility="Collapsed" />
            <local:LogPage x:Name="LogView" Visibility="Collapsed" />
            <local:SettingsPage x:Name="SettingsView" Visibility="Collapsed" />
            <local:AboutPage x:Name="AboutView" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
