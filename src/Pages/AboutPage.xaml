<UserControl Language="zh-CN"
    x:Class="LTOG.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LTOG">

    <ScrollViewer Padding="16,0">
        <StackPanel Spacing="12" MaxWidth="960" Margin="0,12">
            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image x:Name="AboutIcon" Width="120" Height="120"
                           VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="LTOG" FontSize="28" IsTextSelectionEnabled="True" FontWeight="SemiBold" />
                            <Border CornerRadius="12" Padding="10,4"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <TextBlock x:Name="AboutVersionText" Text="v0.0.0" IsTextSelectionEnabled="True"
                                           FontSize="14" FontWeight="SemiBold" Opacity="0.9" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="通过 WinFsp 提供的 Windows LTFS 磁带文件系统" IsTextSelectionEnabled="True"
                                   Opacity="0.8" TextWrapping="Wrap" />
                        <TextBlock Text="中文界面及挂载 / 卸载完成提醒 · 修改于 2026-10-29"
                                   IsTextSelectionEnabled="True" Opacity="0.8" TextWrapping="Wrap" />
                        <TextBlock x:Name="AboutBuildText" IsTextSelectionEnabled="True" FontSize="12" Opacity="0.65"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                        <Button Padding="4" Margin="-4,2,0,0" Background="Transparent"
                                BorderThickness="0" HorizontalAlignment="Left"
                                ToolTipService.ToolTip="github.com/rlaphoenix/LTOG"
                                Click="GitHub_Click">
                            <Viewbox Width="20" Height="20">
                                <PathIcon Data="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel>
                <TextBlock Text="组件" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="AboutLtfsText" IsTextSelectionEnabled="True" Text="LTFS 引擎：—"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="AboutWinFspText" IsTextSelectionEnabled="True" Text="WinFsp: —"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="AboutRuntimeText" IsTextSelectionEnabled="True" Text="运行时：—"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="致谢" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="8">
                        <TextBlock TextWrapping="Wrap" Opacity="0.85" IsTextSelectionEnabled="True"
                                   Text="IBM — 原始线性磁带文件系统（libltfs 及核心工具，由 IBM Almaden Research 开发）。" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.85" IsTextSelectionEnabled="True"
                                   Text="Hewlett-Packard / HPE — Windows 移植版本及 ltotape 磁带机后端。" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.85" IsTextSelectionEnabled="True"
                                   Text="OSR Open Systems Resources — HP 代码中原始的 Windows FUSE 集成。" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.85" IsTextSelectionEnabled="True"
                                   Text="WinLtfs — LTOG 内置的 LTFS + WinFsp 磁带引擎，将 HP 的 LTFS 移植到适用于现代 Windows 的 WinFsp。" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.85" IsTextSelectionEnabled="True"
                                   Text="Bill Zissimopoulos — WinFsp，其兼容 FUSE 的接口层与签名驱动使本方案得以实现。" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.65" FontSize="12"
                                   IsTextSelectionEnabled="True" Text="移植与编排工作由 Claude（Anthropic）协助完成。" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="开源许可" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="8">
                        <TextBlock TextWrapping="Wrap" Opacity="0.85" IsTextSelectionEnabled="True"
                                   Text="LTOG 是按 GNU 通用公共许可证第 3 版（GPLv3）发布的自由软件。" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.85" IsTextSelectionEnabled="True"
                                   Text="本软件包含按各自许可分发的第三方组件：WinFsp（GPLv3，附 FLOSS 例外）；IBM/HP LTFS 引擎与 GNU libiconv（LGPL-2.1）；libxml2、ICU、zlib 及 MinGW-w64 运行库（宽松许可）；GCC 运行库（GPLv3，附运行库例外）；Microsoft Windows App SDK（Microsoft 软件许可条款）；以及 .NET 8 运行时（MIT）。" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.65" FontSize="12" IsTextSelectionEnabled="True"
                                   Text="各组件的完整声明与许可文本随安装包提供，详见 THIRD-PARTY-NOTICES.md 和 licenses 文件夹。" />
                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,2,0,0">
                            <HyperlinkButton Content="开源许可（GPLv3）" Padding="0"
                                             NavigateUri="https://github.com/rlaphoenix/LTOG/blob/main/LICENSE" />
                            <HyperlinkButton Content="第三方组件声明" Padding="0"
                                             NavigateUri="https://github.com/rlaphoenix/LTOG/blob/main/THIRD-PARTY-NOTICES.md" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
