<UserControl Language="zh-CN"
    x:Class="LTOG.NoDrivesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LTOG">

    <ScrollViewer Padding="16,0">
        <StackPanel MaxWidth="560" Spacing="20" Margin="0,48" VerticalAlignment="Center">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <Grid HorizontalAlignment="Center" Margin="0,0,0,8">
                    <FontIcon Glyph="&#xEDA2;" FontSize="72"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <FontIcon Glyph="&#xE783;" FontSize="26" Margin="0,0,-10,-6"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom"
                              Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                </Grid>
                <TextBlock Text="未检测到磁带机" HorizontalAlignment="Center"
                           Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="请连接磁带机。如果已经连接，请按以下步骤排查。"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel Spacing="16">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="18" VerticalAlignment="Top"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <FontIcon Glyph="&#xE7E8;" FontSize="16"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="1. 开启电源" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="打开磁带机电源，并等待自检完成。" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="18" VerticalAlignment="Top"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <FontIcon Glyph="&#xE71B;" FontSize="16"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="2. 检查连接" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="检查 SAS、FC 或 USB 线缆以及主机适配器。" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="18" VerticalAlignment="Top"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <FontIcon Glyph="&#xE90F;" FontSize="16"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="3. 安装磁带机驱动" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="安装厂商提供的 LTO 驱动（HPE、IBM、Quantum 等）。" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
                </StackPanel>
            </Border>

            <Button Content="打开设备管理器" HorizontalAlignment="Center" Click="DeviceManager_Click" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
