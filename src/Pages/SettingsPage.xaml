<UserControl Language="zh-CN"
    x:Class="LTOG.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LTOG">

    <ScrollViewer Padding="16,0">
        <StackPanel Spacing="12" MaxWidth="960" Margin="0,12">
            <StackPanel>
                <TextBlock Text="挂载设置" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="8">
                        <CheckBox x:Name="EjectAfterUnmountCheck"
                                  Content="卸载后弹出磁带"
                                  Click="SettingChanged" />
                        <CheckBox x:Name="RemountCheck"
                                  Content="系统启动时重新挂载"
                                  Click="SettingChanged" />
                        <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True"
                                   Text="适用于所有磁带机。启动时将使用原盘符，重新挂载 LTOG 上次运行时已挂载的磁带。" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="索引" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="10">
                            <CheckBox x:Name="CaptureIndexCheck"
                                      Content="在挂载和卸载时保存索引快照"
                                      IsChecked="True" Click="SettingChanged" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="工作文件夹" VerticalAlignment="Center" />
                                <TextBox x:Name="WorkFolderBox" Grid.Column="1" Text="C:\tmp\ltfs"
                                         LostFocus="SettingChanged" />
                            </Grid>
                            <TextBlock IsTextSelectionEnabled="True" Text="快照是 LTFS 索引 XML 文件，用于在磁带之外备份卷元数据。可在“搜索”和“磁带”页面浏览。"
                                       FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <CheckBox x:Name="OverridePolicyCheck"
                                      Content="覆盖默认索引更新策略"
                                      Click="SettingChanged" />
                            <RadioButton x:Name="PolicyDismountRadio" GroupName="SyncPolicy"
                                         Content="卸载时" Margin="24,0,0,0"
                                         IsEnabled="False" Click="SettingChanged" />
                            <RadioButton x:Name="PolicyPeriodicRadio" GroupName="SyncPolicy"
                                         IsChecked="True" Margin="24,0,0,0"
                                         IsEnabled="False" Click="SettingChanged">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="定期，每隔" VerticalAlignment="Center" />
                                    <NumberBox x:Name="PeriodBox" Minimum="1" Maximum="1440"
                                               SmallChange="1" SpinButtonPlacementMode="Compact"
                                               ValueChanged="Number_ValueChanged" />
                                    <TextBlock Text="分钟" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True" Text="默认策略：每次关闭已修改的文件时，将索引写入磁带（sync_type=close）。" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="日志" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="诊断报告文件夹" />
                            <TextBox x:Name="LogDirBox"
                                     PlaceholderText="C:\ProgramData\LTOG"
                                     LostFocus="SettingChanged" />
                            <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True"
                                       Text="LTFS 保存诊断报告的文件夹" />
                        </StackPanel>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="日志详细程度" VerticalAlignment="Center" />
                            <ComboBox x:Name="VerbosityCombo" Grid.Column="1"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="SettingChanged">
                                <ComboBoxItem Content="普通" />
                                <ComboBoxItem Content="详细（跟踪）" />
                                <ComboBoxItem Content="完整跟踪（较慢）" />
                            </ComboBox>
                        </Grid>
                        <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True"
                                   Text="这些选项将在下次挂载时生效。更详细的日志会明显降低性能，仅适合故障诊断。" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="高级挂载选项" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                            <CheckBox x:Name="AppendOnlyCheck"
                                      Content="仅追加模式（LTO-7 及更新型号）"
                                      Click="SettingChanged" />
                            <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True"
                                       Text="防止磁带上的现有数据被覆盖或擦除：可以添加文件，但不能修改或删除。仅支持 LTO-7 及更新型号的磁带机。" />
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <CheckBox x:Name="OverrideIndexCheck"
                                      Content="挂载时覆盖格式化时设定的配置"
                                      Click="SettingChanged" />
                            <StackPanel Margin="28,0,0,0" Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="允许写入索引分区的文件大小上限"
                                               VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <NumberBox x:Name="IndexSizeBox" Minimum="1" Maximum="999999"
                                               SmallChange="1" SpinButtonPlacementMode="Compact" Width="120"
                                               ValueChanged="Number_ValueChanged" />
                                    <ComboBox x:Name="IndexUnitCombo" VerticalAlignment="Center"
                                              SelectionChanged="SettingChanged">
                                        <ComboBoxItem Content="KB" />
                                        <ComboBoxItem Content="MB" />
                                        <ComboBoxItem Content="GB" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="文件名匹配规则" />
                                    <TextBox x:Name="IndexNameBox" PlaceholderText="*.jpg:*.gif"
                                             LostFocus="SettingChanged" />
                                    <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                                               IsTextSelectionEnabled="True"
                                               Text="可写入索引分区的文件名匹配规则，以冒号分隔，例如 *.jpg:*.gif" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True"
                                       Text="将常用的小文件保存在索引分区中以加快访问。仅在格式化时允许覆盖策略的磁带上生效（mkltfs 未使用 --no-override）。" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
